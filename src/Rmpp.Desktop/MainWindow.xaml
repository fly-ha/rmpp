<Window x:Class="Rmpp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Rmpp.Desktop.Views"
        xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        Title="{DynamicResource AppTitle}"
        Width="1280" Height="820" MinWidth="960" MinHeight="640"
        Background="{DynamicResource CanvasBackgroundBrush}"
        KeyboardNavigation.TabNavigation="Cycle"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="{DynamicResource FileMenu}">
        <MenuItem Header="{DynamicResource NewTemplate}" Command="{Binding NewDocumentCommand}" InputGestureText="Ctrl+N" />
        <MenuItem Header="{DynamicResource OpenTemplate}" Click="OnOpenTemplate" InputGestureText="Ctrl+O" />
        <MenuItem Header="{DynamicResource SaveTemplate}" Click="OnSaveTemplate" InputGestureText="Ctrl+S" />
        <MenuItem Header="{DynamicResource SaveTemplateAs}" Click="OnSaveTemplateAs" InputGestureText="Ctrl+Shift+S" />
        <Separator />
        <MenuItem Header="{DynamicResource DeleteTemplate}" Click="OnDeleteTemplate" />
        <MenuItem Header="{DynamicResource CloseTemplate}" Command="{Binding CloseActiveDocumentCommand}" />
      </MenuItem>
      <MenuItem Header="{DynamicResource EditMenu}">
        <MenuItem Header="{DynamicResource Undo}" Command="{Binding ActiveDocument.UndoCommand}" InputGestureText="Ctrl+Z" />
        <MenuItem Header="{DynamicResource Redo}" Command="{Binding ActiveDocument.RedoCommand}" InputGestureText="Ctrl+Y" />
        <Separator />
        <MenuItem Header="{DynamicResource Delete}" Command="{Binding ActiveDocument.DeleteCommand}" InputGestureText="Delete" />
      </MenuItem>
      <MenuItem Header="{DynamicResource DataMenu}">
        <MenuItem Header="{DynamicResource ImportData}" Command="{Binding ImportDataCommand}" />
      </MenuItem>
      <MenuItem Header="{DynamicResource OutputMenu}">
        <MenuItem Header="{DynamicResource PrintSetup}" Command="{Binding PrintSetupCommand}" />
        <MenuItem Header="{DynamicResource Calibration}" Command="{Binding CalibrationCommand}" />
      </MenuItem>
      <MenuItem Header="{DynamicResource ToolsMenu}">
        <MenuItem Header="{DynamicResource Recovery}" Command="{Binding RecoveryCommand}" />
        <MenuItem Header="{DynamicResource Settings}" Command="{Binding SettingsCommand}" />
      </MenuItem>
      <MenuItem Header="{DynamicResource HelpMenu}" Command="{Binding HelpCommand}" />
    </Menu>

    <ToolBarTray DockPanel.Dock="Top" IsLocked="True" Margin="0,2,0,0">
      <ToolBar Focusable="False" AutomationProperties.Name="常用操作">
        <Button Command="{Binding NewDocumentCommand}" ToolTip="{DynamicResource NewTemplate}"
                AutomationProperties.Name="{DynamicResource NewTemplate}">
          <materialDesign:PackIcon Kind="FilePlusOutline" Width="18" Height="18" />
        </Button>
        <Button Click="OnOpenTemplate" ToolTip="{DynamicResource OpenTemplate}"
                AutomationProperties.Name="{DynamicResource OpenTemplate}">
          <materialDesign:PackIcon Kind="FolderOpenOutline" Width="18" Height="18" />
        </Button>
        <Button Click="OnSaveTemplate" ToolTip="{DynamicResource SaveTemplate}"
                AutomationProperties.Name="{DynamicResource SaveTemplate}">
          <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" />
        </Button>
        <Separator />
        <Button Command="{Binding ActiveDocument.UndoCommand}" ToolTip="{DynamicResource Undo}"
                AutomationProperties.Name="{DynamicResource Undo}">
          <materialDesign:PackIcon Kind="Undo" Width="18" Height="18" />
        </Button>
        <Button Command="{Binding ActiveDocument.RedoCommand}" ToolTip="{DynamicResource Redo}"
                AutomationProperties.Name="{DynamicResource Redo}">
          <materialDesign:PackIcon Kind="Redo" Width="18" Height="18" />
        </Button>
        <Separator />
        <Button Command="{Binding ImportDataCommand}" ToolTip="{DynamicResource ImportData}"
                AutomationProperties.Name="{DynamicResource ImportData}">
          <materialDesign:PackIcon Kind="DatabaseImportOutline" Width="18" Height="18" />
        </Button>
        <Button Command="{Binding PrintSetupCommand}" ToolTip="{DynamicResource PrintSetup}"
                AutomationProperties.Name="{DynamicResource PrintSetup}">
          <materialDesign:PackIcon Kind="PrinterOutline" Width="18" Height="18" />
        </Button>
        <Separator />
        <TextBlock Text="红枫叶定位打印" Foreground="{DynamicResource PrimaryBrush}"
                   FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
      </ToolBar>
    </ToolBarTray>

    <StatusBar DockPanel.Dock="Bottom" AutomationProperties.Name="当前状态">
      <StatusBarItem>
        <TextBlock Text="{Binding ActiveDocument.Status.Text}" />
      </StatusBarItem>
    </StatusBar>

    <TabControl x:Name="DocumentsTabs"
                ItemsSource="{Binding Documents}"
                SelectedItem="{Binding ActiveDocument}"
                Margin="4"
                AutomationProperties.Name="{DynamicResource OpenDocuments}">
      <TabControl.ItemTemplate>
        <DataTemplate>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding DisplayTitle}" />
            <TextBlock Text=" *" Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate>
          <views:DesignerView />
        </DataTemplate>
      </TabControl.ContentTemplate>
    </TabControl>
  </DockPanel>
</Window>
