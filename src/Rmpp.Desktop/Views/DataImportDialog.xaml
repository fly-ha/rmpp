<Window x:Class="Rmpp.Desktop.Views.DataImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导入数据" Width="760" Height="560" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" KeyboardNavigation.TabNavigation="Cycle">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="取消" Command="{Binding CancelCommand}" Margin="0,0,8,0" KeyboardNavigation.TabIndex="9" />
      <Button Content="导入" Command="{Binding ImportCommand}" IsDefault="True" KeyboardNavigation.TabIndex="10" />
    </StackPanel>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="本地文件" VerticalAlignment="Center" />
      <TextBox x:Name="FilePathInput" Grid.Row="0" Grid.Column="1" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged}" Margin="6,2"
               KeyboardNavigation.TabIndex="0" AutomationProperties.Name="{DynamicResource DataFilePath}" />
      <Button x:Name="ChooseDataFileButton" Grid.Row="0" Grid.Column="2" Content="选择文件…" Click="OnChooseFile" Margin="6,2"
              KeyboardNavigation.TabIndex="1" AutomationProperties.Name="选择数据文件" />
      <TextBlock Grid.Row="1" Grid.Column="0" Text="编码 / 分隔符" VerticalAlignment="Center" />
      <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal">
        <TextBox Width="120" Text="{Binding EncodingName}" Margin="6,2" KeyboardNavigation.TabIndex="2" AutomationProperties.Name="字符编码" />
        <TextBox Width="40" Text="{Binding Delimiter}" Margin="6,2" KeyboardNavigation.TabIndex="3" AutomationProperties.Name="字段分隔符" />
        <TextBox Width="40" Text="{Binding Quote}" Margin="6,2" KeyboardNavigation.TabIndex="4" AutomationProperties.Name="引用字符" />
        <CheckBox Content="首行为标题" IsChecked="{Binding HasHeaderRow}" VerticalAlignment="Center" Margin="10,2" KeyboardNavigation.TabIndex="5" />
        <TextBox Width="130" ToolTip="Excel 工作表" Text="{Binding WorksheetName}" Margin="6,2" KeyboardNavigation.TabIndex="6" AutomationProperties.Name="Excel 工作表" />
        <TextBox Width="110" ToolTip="Excel 范围，例如 A1:C20" Text="{Binding CellRange}" Margin="6,2" KeyboardNavigation.TabIndex="7" AutomationProperties.Name="Excel 单元格范围" />
      </StackPanel>
      <ListBox x:Name="PreviewRows" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" ItemsSource="{Binding PreviewLines}" Margin="0,10,0,4"
               KeyboardNavigation.TabIndex="8" AutomationProperties.Name="{DynamicResource DataPreviewRows}" />
      <StackPanel Grid.Row="3" Grid.ColumnSpan="3">
        <TextBlock Text="{Binding StatusText}" />
        <TextBlock Text="{Binding ErrorText}" Foreground="IndianRed" TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
