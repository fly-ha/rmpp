<UserControl x:Class="Rmpp.Desktop.Views.DataPreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True" KeyboardNavigation.TabNavigation="Contained">
  <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></UserControl.Resources>
  <Grid Margin="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="数据记录" FontWeight="Bold" Visibility="{Binding HasDataSource, Converter={StaticResource BoolToVisibility}}"/>
      <WrapPanel Visibility="{Binding HasDataSource, Converter={StaticResource BoolToVisibility}}" Margin="0,5,0,0">
        <Button Content="上一行" Command="{Binding PreviousRowCommand}" Margin="0,0,4,0"/>
        <Button Content="下一行" Command="{Binding NextRowCommand}" Margin="0,0,8,0"/>
        <TextBox x:Name="SearchInput" Width="110" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 KeyboardNavigation.TabIndex="2" AutomationProperties.Name="数据搜索"/>
        <Button Content="查找" Command="{Binding FindNextCommand}" Margin="4,0,0,0"/>
      </WrapPanel>
      <WrapPanel Visibility="{Binding HasDataSource, Converter={StaticResource BoolToVisibility}}" Margin="0,5,0,0">
        <TextBox Width="45" Text="{Binding RangeStart}"/><TextBlock Text=" - " VerticalAlignment="Center"/><TextBox Width="45" Text="{Binding RangeEnd}"/>
        <Button Content="选择范围" Command="{Binding ApplyRangeCommand}" Margin="4,0,0,0"/>
      </WrapPanel>
      <TextBlock Text="未导入数据：显示模板元素，选择后会联动画布。" TextWrapping="Wrap" FontWeight="SemiBold">
        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasDataSource}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
    </StackPanel>
    <Grid Grid.Row="1" Margin="0,8,0,0">
      <ListBox x:Name="FieldsList" ItemsSource="{Binding CurrentValues}" PreviewMouseMove="OnFieldMouseMove"
               KeyboardNavigation.TabIndex="7" AutomationProperties.Name="字段和值列表">
        <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDataSource}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
        <ListBox.ItemTemplate><DataTemplate><Grid Margin="3"><Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <ListBox ItemsSource="{Binding Elements}" SelectedItem="{Binding SelectedElement}" DisplayMemberPath="Name" AutomationProperties.Name="模板元素列表">
        <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasDataSource}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ListBox.Style>
      </ListBox>
    </Grid>
    <TextBlock Grid.Row="2" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
  </Grid>
</UserControl>
