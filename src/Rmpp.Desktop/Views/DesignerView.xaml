<UserControl x:Class="Rmpp.Desktop.Views.DesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rmpp.Desktop.Controls"
             xmlns:views="clr-namespace:Rmpp.Desktop.Views"
             xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
             xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
             Focusable="True"
             KeyboardNavigation.TabNavigation="Contained">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="236" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="300" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" Padding="12">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
          <materialDesign:PackIcon Kind="ToolboxOutline" Width="19" Height="19"
                                   Foreground="{DynamicResource PrimaryBrush}" Margin="0,0,6,0" />
          <TextBlock Text="{DynamicResource Toolbox}" FontWeight="SemiBold" />
        </StackPanel>
        <ListBox x:Name="ToolboxList"
                 Grid.Row="1"
                 ItemsSource="{Binding Designer.Tools}"
                 SelectedValue="{Binding Designer.ActiveTool, Mode=TwoWay}"
                 SelectedValuePath="Tool"
                 PreviewMouseLeftButtonDown="OnToolboxMouseLeftButtonDown"
                 PreviewMouseMove="OnToolboxMouseMove"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Background="Transparent"
                 AutomationProperties.Name="{DynamicResource Toolbox}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding DisplayName}" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <ScrollViewer Grid.Row="2" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Separator Margin="0,0,0,8" />
          <TextBlock Text="页面设置" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
          <TextBlock Text="介质名称" Margin="0,6,0,0" />
          <TextBox Text="{Binding Designer.PageMediaName, UpdateSourceTrigger=LostFocus}" />
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="8" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="宽度 (mm)" />
              <controls:BufferedNumericTextBox Value="{Binding Designer.PageWidthMm}" Minimum="0.1" />
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="高度 (mm)" />
              <controls:BufferedNumericTextBox Value="{Binding Designer.PageHeightMm}" Minimum="0.1" />
            </StackPanel>
          </Grid>
          <TextBlock Text="方向" Margin="0,4,0,0" />
          <ComboBox ItemsSource="{Binding Designer.PageOrientations}"
                    SelectedItem="{Binding Designer.PageOrientation}" />
          <TextBlock Text="模板尺寸是设计、预览和 PDF 的物理尺寸；打印设置默认跟随此尺寸。"
                     TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,0" />
          <Separator Margin="0,8" />
          <TextBlock Text="{DynamicResource Background}" FontWeight="Bold" />
          <Button Content="{DynamicResource ImportBackground}" Click="OnImportBackground" Margin="0,6,0,4" />
          <CheckBox Content="{DynamicResource BackgroundVisible}"
                    IsChecked="{Binding Designer.ActiveBackgroundVisible}"
                    IsEnabled="{Binding Designer.HasBackground}" />
          <CheckBox Content="{DynamicResource BackgroundPrintable}"
                    IsChecked="{Binding Designer.ActiveBackgroundPrintable}"
                    IsEnabled="{Binding Designer.HasBackground}" />
          <CheckBox Content="{DynamicResource BackgroundLocked}"
                    IsChecked="{Binding Designer.ActiveBackgroundLocked}"
                    IsEnabled="{Binding Designer.HasBackground}" />
          <TextBlock Text="{DynamicResource BackgroundFit}" Margin="0,4,0,0" />
          <ComboBox ItemsSource="{Binding Designer.BackgroundFitModes}"
                    SelectedItem="{Binding Designer.ActiveBackgroundFitMode}"
                    IsEnabled="{Binding Designer.HasBackground}" />
          <TextBlock Text="{DynamicResource BackgroundOpacity}" Margin="0,4,0,0" />
          <Slider Minimum="0" Maximum="1" TickFrequency="0.05"
                  Value="{Binding Designer.ActiveBackgroundOpacity}"
                  IsEnabled="{Binding Designer.HasBackground}" />
          <TextBlock Text="{DynamicResource BackgroundPdfPage}" Margin="0,4,0,0" />
          <controls:BufferedNumericTextBox Value="{Binding Designer.ActiveBackgroundPdfPageNumberValue}" IsInteger="True" Minimum="1"
                   IsEnabled="{Binding Designer.HasBackground}" />
          <Button Content="{DynamicResource DeleteBackground}" Click="OnDeleteBackground"
                  IsEnabled="{Binding Designer.HasBackground}" Margin="0,6,0,0" />
          <TextBlock Text="{Binding Designer.BackgroundStatus}" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
          <Separator Margin="0,8" />
          <TextBlock Text="{DynamicResource Zoom}" />
          <Slider x:Name="ZoomSlider"
                  Minimum="0.1" Maximum="4" Value="{Binding Designer.Zoom}" TickFrequency="0.1"
                  KeyboardNavigation.TabIndex="0"
                  AutomationProperties.Name="{DynamicResource DesignerZoom}" />
        </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Background="{DynamicResource CanvasBackgroundBrush}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="24" /><RowDefinition /></Grid.RowDefinitions>
      <ToolBar Grid.Row="0" Focusable="False" AutomationProperties.Name="画布工具栏">
        <ToggleButton IsChecked="{Binding Designer.ShowGrid}" ToolTip="{DynamicResource Grid}"
                      AutomationProperties.Name="{DynamicResource Grid}">
          <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Grid" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource Grid}" /></StackPanel>
        </ToggleButton>
        <ToggleButton IsChecked="{Binding Designer.SnappingEnabled}" ToolTip="{DynamicResource Snapping}"
                      AutomationProperties.Name="{DynamicResource Snapping}">
          <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Magnet" Width="16" Height="16" Margin="0,0,5,0"/><TextBlock Text="{DynamicResource Snapping}" /></StackPanel>
        </ToggleButton>
        <Separator />
        <Button Content="{DynamicResource AlignLeft}" Click="OnAlignLeft" ToolTip="{DynamicResource AlignLeft}" AutomationProperties.Name="{DynamicResource AlignLeft}" />
        <Button Content="{DynamicResource AlignCenter}" Click="OnAlignCenter" ToolTip="{DynamicResource AlignCenter}" AutomationProperties.Name="{DynamicResource AlignCenter}" />
        <Button Content="{DynamicResource AlignTop}" Click="OnAlignTop" ToolTip="{DynamicResource AlignTop}" AutomationProperties.Name="{DynamicResource AlignTop}" />
        <Button Content="{DynamicResource DistributeHorizontal}" Click="OnDistributeHorizontal" ToolTip="{DynamicResource DistributeHorizontal}" AutomationProperties.Name="{DynamicResource DistributeHorizontal}" />
        <Button Content="{DynamicResource DistributeVertical}" Click="OnDistributeVertical" ToolTip="{DynamicResource DistributeVertical}" AutomationProperties.Name="{DynamicResource DistributeVertical}" />
        <Separator />
        <Button Content="{DynamicResource AddHorizontalGuide}" Click="OnAddHorizontalGuide" ToolTip="{DynamicResource AddHorizontalGuide}" AutomationProperties.Name="{DynamicResource AddHorizontalGuide}" />
        <Button Content="添加垂直参考线" Click="OnAddVerticalGuide" ToolTip="添加垂直参考线" AutomationProperties.Name="添加垂直参考线" />
        <Button Content="{DynamicResource ClearGuides}" Click="OnClearGuides" ToolTip="{DynamicResource ClearGuides}" AutomationProperties.Name="{DynamicResource ClearGuides}" />
        <TextBlock Text="{Binding Designer.SnapIndicator}" Foreground="{DynamicResource SecondaryBrush}"
                   Margin="12,0" VerticalAlignment="Center" />
      </ToolBar>
      <controls:RulerControl Grid.Row="1" Orientation="Horizontal" Zoom="{Binding Designer.Zoom}" />
      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PanningMode="Both">
        <controls:DesignerSurface x:Name="Surface"
                                  Focusable="True"
                                  KeyboardNavigation.TabIndex="1"
                                  AutomationProperties.Name="{DynamicResource DesignerCanvas}"
                                  Document="{Binding Designer.Document}"
                                  AssetContents="{Binding Designer.AssetContents}"
                                  SelectedElementIds="{Binding Designer.SelectedElementIds}"
                                  ActiveTool="{Binding Designer.ActiveTool}"
                                  Zoom="{Binding Designer.Zoom}"
                                  ShowGrid="{Binding Designer.ShowGrid}"
                                  GridSpacingMm="{Binding Designer.GridSpacingMm}"
                                  ElementSelected="OnElementSelected"
                                  ElementCreateRequested="OnElementCreateRequested"
                                  ElementsMoved="OnElementsMoved"
                                  ElementResized="OnElementResized"
                                  GuideMoved="OnGuideMoved" />
      </ScrollViewer>
    </Grid>

    <TabControl x:Name="InspectorTabs"
                Grid.Column="2" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                KeyboardNavigation.TabIndex="2"
                AutomationProperties.Name="{DynamicResource InspectorTabs}">
      <TabItem Header="{DynamicResource Properties}"><views:PropertiesPanelView /></TabItem>
      <TabItem Header="{DynamicResource Layers}"><views:LayersPanelView /></TabItem>
      <TabItem Header="{DynamicResource DataPreview}"><views:DataPreviewPanel DataContext="{Binding DataPreview}" /></TabItem>
      <TabItem Header="{DynamicResource ExpressionEditor}"><views:ExpressionEditorView DataContext="{Binding ExpressionEditor}" /></TabItem>
    </TabControl>
  </Grid>
</UserControl>
