<UserControl x:Class="Rmpp.Desktop.Views.LayersPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <TextBlock Text="选择图层后，可分别控制编辑器可见性、编辑锁定和输出状态。" TextWrapping="Wrap" Foreground="DimGray" Margin="2,0,2,6"/>
    <ListBox x:Name="LayersList" Grid.Row="1" ItemsSource="{Binding Layers.Layers}" AutomationProperties.Name="图层列表">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,0,2,3"/>
              <WrapPanel Grid.Row="1">
              <CheckBox Content="可见" IsChecked="{Binding IsVisible, Mode=OneWay}"
                            Command="{Binding DataContext.Layers.ToggleVisibleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            ToolTip="关闭后图层在编辑器中隐藏" AutomationProperties.Name="图层可见" Margin="2"/>
              <CheckBox Content="锁定" IsChecked="{Binding IsLocked, Mode=OneWay}"
                            Command="{Binding DataContext.Layers.ToggleLockedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            ToolTip="锁定后不能选择或修改图层元素" AutomationProperties.Name="图层锁定" Margin="8,2,2,2"/>
              <CheckBox Content="输出" IsChecked="{Binding IsPrintable, Mode=OneWay}"
                            Command="{Binding DataContext.Layers.TogglePrintableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"
                            ToolTip="关闭后仍可编辑和显示，但预览、PDF 与打印会排除此图层" AutomationProperties.Name="图层输出" Margin="8,2,2,2"/>
              </WrapPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </Grid>
</UserControl>
