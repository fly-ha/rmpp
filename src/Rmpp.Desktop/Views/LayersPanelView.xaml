<UserControl x:Class="Rmpp.Desktop.Views.LayersPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ListBox x:Name="LayersList" Margin="8" ItemsSource="{Binding Layers.Layers}" AutomationProperties.Name="{DynamicResource Layers}">
    <ListBox.ItemTemplate>
      <DataTemplate>
        <Grid Margin="2">
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="{DynamicResource LayerVisible}" Command="{Binding DataContext.Layers.ToggleVisibleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="4,1" />
          <Button Grid.Column="2" Content="{DynamicResource LayerLock}" Command="{Binding DataContext.Layers.ToggleLockedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="4,1" />
          <Button Grid.Column="3" Content="{DynamicResource LayerPrint}" Command="{Binding DataContext.Layers.TogglePrintableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Padding="4,1" />
        </Grid>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
