<UserControl x:Class="Rmpp.Desktop.Views.PrintPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             KeyboardNavigation.TabNavigation="Contained">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center">
      <Button Content="上一页" Command="{Binding PreviousPageCommand}" Margin="4"/>
      <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,0"/>
      <Button Content="下一页" Command="{Binding NextPageCommand}" Margin="4"/>
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#E8EAED">
      <Border Background="White" Margin="16" Padding="1"><Image x:Name="PreviewImage" Source="{Binding PageImage}" Stretch="Uniform" AutomationProperties.Name="{DynamicResource PreviewPageImage}"/></Border>
    </ScrollViewer>
  </DockPanel>
</UserControl>
