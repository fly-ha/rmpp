<Window x:Class="Rmpp.Desktop.Views.PrintSetupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Rmpp.Desktop.Controls"
        xmlns:views="clr-namespace:Rmpp.Desktop.Views"
        Title="打印设置与预览" Width="1120" Height="760" WindowStartupLocation="CenterOwner"
        KeyboardNavigation.TabNavigation="Cycle" Loaded="OnLoaded">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
  </Window.Resources>
  <Grid Margin="12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="380"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,12,0">
        <GroupBox Header="打印机与介质" Margin="0,0,0,8">
          <StackPanel Margin="8">
            <DockPanel>
              <TextBlock Text="打印机" VerticalAlignment="Center"/>
              <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshPrintersCommand}" Padding="10,2"/>
            </DockPanel>
            <ComboBox x:Name="PrinterCombo" ItemsSource="{Binding Printers}" SelectedItem="{Binding SelectedPrinter}" DisplayMemberPath="Identity.DisplayName"
                      KeyboardNavigation.TabIndex="0" AutomationProperties.Name="打印机选择"/>
            <TextBlock Text="介质" Margin="0,8,0,0"/>
            <ComboBox x:Name="MediaCombo" ItemsSource="{Binding Media}" SelectedItem="{Binding SelectedMedia}" DisplayMemberPath="DisplayName"
                      KeyboardNavigation.TabIndex="1" AutomationProperties.Name="介质选择"/>
            <UniformGrid Columns="2" Margin="0,6,0,0">
              <StackPanel Margin="0,0,4,0"><TextBlock Text="自定义宽度 (mm)"/><controls:BufferedNumericTextBox Value="{Binding CustomWidthMm}" Minimum="0.1"/></StackPanel>
              <StackPanel Margin="4,0,0,0"><TextBlock Text="自定义高度 (mm)"/><controls:BufferedNumericTextBox Value="{Binding CustomHeightMm}" Minimum="0.1"/></StackPanel>
            </UniformGrid>
            <TextBlock Text="方向" Margin="0,8,0,0"/>
            <ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding SelectedOrientation}"/>
            <TextBlock Text="分辨率" Margin="0,8,0,0"/>
            <ComboBox x:Name="ResolutionCombo" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" DisplayMemberPath="Key"
                      KeyboardNavigation.TabIndex="2" AutomationProperties.Name="分辨率选择"/>
            <TextBlock Text="{Binding MediaMismatchText}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="DarkOrange"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="记录、流水号与份数" Margin="0,0,0,8">
          <StackPanel Margin="8">
            <TextBlock Text="{Binding DataSourceModeText}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            <StackPanel Margin="0,6,0,0" Visibility="{Binding HasDataSource, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Text="记录范围（参与计划的数据行）"/>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <controls:BufferedNumericTextBox Width="70" Value="{Binding FirstRecordValue}" IsInteger="True" Minimum="1" Maximum="{Binding MaximumRecord}" AutomationProperties.Name="首条记录"/>
                <TextBlock Text=" 至 " VerticalAlignment="Center"/>
                <controls:BufferedNumericTextBox Width="70" Value="{Binding LastRecordValue}" IsInteger="True" Minimum="1" Maximum="{Binding MaximumRecord}" AutomationProperties.Name="末条记录"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,6,0,0">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers><DataTrigger Binding="{Binding HasDataSource}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                </Style>
              </StackPanel.Style>
              <TextBlock Text="输出数量（无数据源时同时决定流水号逻辑页数）" TextWrapping="Wrap"/>
              <controls:BufferedNumericTextBox Width="90" HorizontalAlignment="Left" Value="{Binding OutputCountValue}" IsInteger="True" Minimum="1" AutomationProperties.Name="输出数量"/>
            </StackPanel>
            <TextBlock Text="打印份数" Margin="0,8,0,0"/>
            <controls:BufferedNumericTextBox Width="90" HorizontalAlignment="Left" Value="{Binding CopiesValue}" IsInteger="True" Minimum="1" AutomationProperties.Name="打印份数"/>
            <TextBlock Text="副本顺序" Margin="0,8,0,0"/>
            <ComboBox ItemsSource="{Binding CopyOrders}" SelectedItem="{Binding CopyOrder}"/>
            <TextBlock Text="{Binding CopyOrderExplanation}" Margin="0,4,0,0" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding SerialSummary}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasSheetLabelLayout, Converter={StaticResource BooleanToVisibility}}">
              <TextBlock Text="标签纸起始版位"/>
              <controls:BufferedNumericTextBox Width="90" HorizontalAlignment="Left" Value="{Binding StartingCellValue}" IsInteger="True" Minimum="1" Maximum="{Binding MaximumStartingCell}" AllowEmpty="True"/>
              <TextBlock Text="{Binding StartingCellExplanation}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,3,0,0"/>
            </StackPanel>
          </StackPanel>
        </GroupBox>

        <WrapPanel Margin="0,0,0,8">
          <Button x:Name="BuildPlanButton" Content="生成计划" Command="{Binding BuildPlanCommand}" Padding="14,5" Margin="0,0,8,0"
                  KeyboardNavigation.TabIndex="8" AutomationProperties.Name="生成打印计划"/>
          <Button Content="保存为模板打印设置" Command="{Binding SaveTemplatePrintSettingsCommand}" Padding="12,5"/>
        </WrapPanel>
        <Button x:Name="PrintButton" Content="打印" Command="{Binding PrintCommand}" Padding="14,5" Margin="0,0,0,8"
                KeyboardNavigation.TabIndex="9" AutomationProperties.Name="打印任务"/>

        <GroupBox Header="本地 PDF">
          <StackPanel Margin="8">
            <TextBox x:Name="PdfPathInput" Text="{Binding PdfExport.OutputPath, UpdateSourceTrigger=PropertyChanged}"
                     KeyboardNavigation.TabIndex="10" AutomationProperties.Name="PDF 输出路径"/>
            <Button Content="选择 PDF 路径…" Click="OnChoosePdf" Margin="0,4"/>
            <StackPanel Orientation="Horizontal">
              <controls:BufferedNumericTextBox Width="70" Value="{Binding PdfExport.FirstPageValue}" IsInteger="True" Minimum="1" AutomationProperties.Name="PDF 起始页"/>
              <TextBlock Text=" 至 " VerticalAlignment="Center"/>
              <controls:BufferedNumericTextBox Width="70" Value="{Binding PdfExport.LastPageValue}" IsInteger="True" Minimum="1" AutomationProperties.Name="PDF 结束页"/>
            </StackPanel>
            <TextBlock Text="{Binding PdfExport.PageRangeExplanation}" TextWrapping="Wrap" Foreground="DimGray" Margin="0,4,0,0"/>
            <CheckBox Content="包含可打印背景" IsChecked="{Binding PdfExport.IncludePrintableBackgrounds}" Margin="0,5,0,0"/>
            <Button Content="导出并验证 PDF" Command="{Binding PdfExport.ExportCommand}" Margin="0,6" Padding="12,4"/>
            <TextBlock Text="{Binding PdfExport.StatusText}" TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>
        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <ItemsControl ItemsSource="{Binding ValidationIssues}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="IndianRed"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
    </ScrollViewer>
    <views:PrintPreviewView Grid.Column="1" DataContext="{Binding Preview}" />
  </Grid>
</Window>
