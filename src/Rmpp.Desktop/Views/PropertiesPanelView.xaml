<UserControl x:Class="Rmpp.Desktop.Views.PropertiesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="10" DataContext="{Binding Properties}">
      <TextBlock Text="{Binding TypeName}" FontWeight="Bold" FontSize="15" Margin="0,0,0,8" AutomationProperties.Name="{DynamicResource Properties}" />
      <TextBlock Text="{DynamicResource Name}" /><TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" automation:AutomationProperties.Name="{DynamicResource ElementName}" />
      <UniformGrid Columns="2" Margin="0,8,0,0">
        <StackPanel><TextBlock Text="X (mm)"/><TextBox Text="{Binding X, UpdateSourceTrigger=LostFocus}" /></StackPanel>
        <StackPanel><TextBlock Text="Y (mm)"/><TextBox Text="{Binding Y, UpdateSourceTrigger=LostFocus}" /></StackPanel>
        <StackPanel><TextBlock Text="{DynamicResource WidthMm}"/><TextBox Text="{Binding Width, UpdateSourceTrigger=LostFocus}" /></StackPanel>
        <StackPanel><TextBlock Text="{DynamicResource HeightMm}"/><TextBox Text="{Binding Height, UpdateSourceTrigger=LostFocus}" /></StackPanel>
        <StackPanel><TextBlock Text="{DynamicResource RotationDegrees}"/><TextBox Text="{Binding Rotation, UpdateSourceTrigger=LostFocus}" /></StackPanel>
        <StackPanel><TextBlock Text="{DynamicResource Opacity}"/><TextBox Text="{Binding Opacity, UpdateSourceTrigger=LostFocus}" /></StackPanel>
      </UniformGrid>
      <WrapPanel Margin="0,8">
        <CheckBox Content="{DynamicResource Visible}" IsChecked="{Binding IsVisible}" Margin="0,0,10,0" />
        <CheckBox Content="{DynamicResource Printable}" IsChecked="{Binding IsPrintable}" Margin="0,0,10,0" />
        <CheckBox Content="{DynamicResource Locked}" IsChecked="{Binding IsLocked}" />
      </WrapPanel>
      <TextBlock Text="{DynamicResource ContentExpressionFormat}" /><TextBox Text="{Binding Content, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="50" />
      <TextBlock Text="{DynamicResource PointCoordinates}" Margin="0,8,0,0"/><TextBox Text="{Binding Points, UpdateSourceTrigger=LostFocus}" />
      <TextBlock Text="{DynamicResource FontFamily}" Margin="0,8,0,0"/><TextBox Text="{Binding FontFamily, UpdateSourceTrigger=LostFocus}" />
      <TextBlock Text="{DynamicResource FontSize}"/><TextBox Text="{Binding FontSize, UpdateSourceTrigger=LostFocus}" />
      <TextBlock Text="{DynamicResource StartAngle}" Margin="0,8,0,0"/><TextBox Text="{Binding StartAngle, UpdateSourceTrigger=LostFocus}" />
      <TextBlock Text="{DynamicResource SweepDegrees}"/><TextBox Text="{Binding SweepDegrees, UpdateSourceTrigger=LostFocus}" />
      <TextBlock Text="{DynamicResource CornerRadius}"/><TextBox Text="{Binding CornerRadius, UpdateSourceTrigger=LostFocus}" />
      <TextBlock Text="{DynamicResource SerialStart}" Margin="0,8,0,0"/><TextBox Text="{Binding SerialStart, UpdateSourceTrigger=LostFocus}" />
      <TextBlock Text="{DynamicResource SerialStep}"/><TextBox Text="{Binding SerialStep, UpdateSourceTrigger=LostFocus}" />
      <TextBlock Text="{DynamicResource BarcodeSymbology}" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding BarcodeSymbologies}" SelectedItem="{Binding Symbology}" />
      <TextBlock Text="{DynamicResource ImageFit}" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding ImageFitModes}" SelectedItem="{Binding ImageFit}" />
      <TextBlock Text="{DynamicResource ImageCrop}"/><TextBox Text="{Binding ImageCrop, UpdateSourceTrigger=LostFocus}" />
      <TextBlock Text="{DynamicResource StrokeWidthMm}" Margin="0,8,0,0"/><TextBox Text="{Binding StrokeWidth, UpdateSourceTrigger=LostFocus}" />
      <TextBlock Text="{DynamicResource Fill}" Margin="0,8,0,0"/>
      <ComboBox SelectedValue="{Binding FillMode}" SelectedValuePath="Tag">
        <ComboBoxItem Content="{DynamicResource NoFill}" Tag="None"/><ComboBoxItem Content="{DynamicResource SolidFill}" Tag="Solid"/><ComboBoxItem Content="{DynamicResource HatchFill}" Tag="Hatch"/>
      </ComboBox>
      <TextBlock Text="{DynamicResource HatchPattern}" Margin="0,8,0,0"/><ComboBox ItemsSource="{Binding HatchPatterns}" SelectedItem="{Binding HatchPattern}" />
      <TextBlock Text="{Binding ValidationSummary}" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,10,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
