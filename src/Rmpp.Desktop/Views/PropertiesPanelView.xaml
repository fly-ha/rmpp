<UserControl x:Class="Rmpp.Desktop.Views.PropertiesPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Rmpp.Desktop.Controls"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,0,8" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Background" Value="{DynamicResource SurfaceMutedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
    </Style>
    <Style TargetType="TextBlock" x:Key="PropertyFieldLabel">
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Margin" Value="0,3,0,1" />
    </Style>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource SurfaceBrush}">
    <StackPanel Margin="12" DataContext="{Binding Properties}">
      <TextBlock Text="{Binding TypeName}" FontWeight="Bold" FontSize="15" Margin="0,0,0,8"
                 AutomationProperties.Name="{DynamicResource Properties}" />

      <GroupBox Header="{DynamicResource CommonProperties}"
                Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"
                Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource Name}" />
          <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                   automation:AutomationProperties.Name="{DynamicResource ElementName}" />
          <UniformGrid Columns="2" Margin="0,8,0,0">
            <StackPanel><TextBlock Text="X (mm)"/><controls:BufferedNumericTextBox Value="{Binding X}" /></StackPanel>
            <StackPanel><TextBlock Text="Y (mm)"/><controls:BufferedNumericTextBox Value="{Binding Y}" /></StackPanel>
            <StackPanel><TextBlock Text="{DynamicResource WidthMm}"/><controls:BufferedNumericTextBox Value="{Binding Width}" Minimum="0.1" /></StackPanel>
            <StackPanel><TextBlock Text="{DynamicResource HeightMm}"/><controls:BufferedNumericTextBox Value="{Binding Height}" Minimum="0.1" /></StackPanel>
            <StackPanel><TextBlock Text="{DynamicResource RotationDegrees}"/><controls:BufferedNumericTextBox Value="{Binding Rotation}" /></StackPanel>
            <StackPanel><TextBlock Text="{DynamicResource Opacity}"/><controls:BufferedNumericTextBox Value="{Binding Opacity}" Minimum="0.01" Maximum="1" /></StackPanel>
          </UniformGrid>
          <WrapPanel Margin="0,8,0,0">
            <CheckBox Content="{DynamicResource Visible}" IsChecked="{Binding IsVisible}" Margin="0,0,10,0" />
            <CheckBox Content="{DynamicResource Printable}" IsChecked="{Binding IsPrintable}" Margin="0,0,10,0" />
            <CheckBox Content="{DynamicResource Locked}" IsChecked="{Binding IsLocked}" />
          </WrapPanel>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="TextPropertiesGroup" Header="{DynamicResource TextProperties}"
                Visibility="{Binding IsTextElement, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource TextContent}" />
          <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged, Delay=150}" AcceptsReturn="True" MinHeight="50" />
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="DateTimePropertiesGroup" Header="{DynamicResource DateTimeProperties}"
                Visibility="{Binding IsDateTimeElement, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource DateTimeFormat}" />
          <TextBox Text="{Binding DateTimeFormat, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="SerialPropertiesGroup" Header="{DynamicResource SerialProperties}"
                Visibility="{Binding IsSerialElement, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource SerialPrefix}"/><TextBox Text="{Binding SerialPrefix, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
          <TextBlock Text="{DynamicResource SerialSuffix}"/><TextBox Text="{Binding SerialSuffix, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
          <TextBlock Text="{DynamicResource SerialStart}"/><controls:BufferedNumericTextBox Value="{Binding SerialStartValue}" IsInteger="True" />
          <TextBlock Text="{DynamicResource SerialStep}"/><controls:BufferedNumericTextBox Value="{Binding SerialStepValue}" IsInteger="True" DisallowZero="True" />
          <TextBlock Text="{DynamicResource SerialMinimumDigits}"/><controls:BufferedNumericTextBox Value="{Binding SerialMinimumDigitsValue}" IsInteger="True" Minimum="0" />
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="BarcodePropertiesGroup" Header="{DynamicResource BarcodeProperties}"
                Visibility="{Binding IsBarcodeElement, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource BarcodeContent}" />
          <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged, Delay=150}" AcceptsReturn="True" MinHeight="45" />
          <TextBlock Text="{DynamicResource BarcodeSymbology}" Margin="0,6,0,0" />
          <ComboBox ItemsSource="{Binding BarcodeSymbologies}" SelectedItem="{Binding Symbology}" />
          <StackPanel Visibility="{Binding IsQrCode, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,8,0,0">
            <TextBlock Text="{DynamicResource QrCenterIcon}" />
            <TextBlock Text="{Binding BarcodeCenterIconDisplayName}" TextWrapping="Wrap" />
            <WrapPanel Margin="0,6,0,0">
              <Button Content="{DynamicResource SelectQrCenterIcon}" Click="OnSelectQrCenterIcon" Margin="0,0,8,0" />
              <Button Content="{DynamicResource ClearQrCenterIcon}" Click="OnClearQrCenterIcon"
                      IsEnabled="{Binding HasBarcodeCenterIcon}" />
            </WrapPanel>
            <TextBlock Text="{DynamicResource QrCenterIconScale}" Margin="0,6,0,0" />
            <controls:BufferedNumericTextBox Value="{Binding BarcodeCenterIconScale}" Minimum="0.1" Maximum="0.25" />
            <TextBlock Text="{Binding DataContext.Designer.BarcodeIconStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       TextWrapping="Wrap" Margin="0,6,0,0" />
          </StackPanel>
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="ImagePropertiesGroup" Header="{DynamicResource ImageProperties}"
                Visibility="{Binding IsImageElement, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource ImageFile}" />
          <TextBlock Text="{Binding ImageDisplayName}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,6,0,0">
            <Button Content="{DynamicResource SelectImage}" Click="OnSelectImage" Margin="0,0,8,0" />
            <Button Content="{DynamicResource ClearImage}" Click="OnClearImage" IsEnabled="{Binding HasImageAsset}" />
          </WrapPanel>
          <TextBlock Text="{DynamicResource ImageFit}" Margin="0,6,0,0" />
          <ComboBox ItemsSource="{Binding ImageFitModes}" SelectedItem="{Binding ImageFit}" />
          <TextBlock Text="{DynamicResource ImageCrop}" />
          <UniformGrid Columns="2">
            <StackPanel><TextBlock Text="X"/><controls:BufferedNumericTextBox Value="{Binding ImageCropX}" AllowEmpty="True" /></StackPanel>
            <StackPanel><TextBlock Text="Y"/><controls:BufferedNumericTextBox Value="{Binding ImageCropY}" AllowEmpty="True" /></StackPanel>
            <StackPanel><TextBlock Text="宽"/><controls:BufferedNumericTextBox Value="{Binding ImageCropWidth}" Minimum="0.1" AllowEmpty="True" /></StackPanel>
            <StackPanel><TextBlock Text="高"/><controls:BufferedNumericTextBox Value="{Binding ImageCropHeight}" Minimum="0.1" AllowEmpty="True" /></StackPanel>
          </UniformGrid>
          <Button Content="清除裁剪" Click="OnClearImageCrop" IsEnabled="{Binding HasImageCrop}" Margin="0,4,0,0" />
          <TextBlock Text="{Binding DataContext.Designer.ImageStatus, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="PointPropertiesGroup" Header="{DynamicResource PointProperties}"
                Visibility="{Binding SupportsPointEditing, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource PointCoordinates}" />
          <TextBox Text="{Binding Points, UpdateSourceTrigger=PropertyChanged, Delay=150}" />
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="ArcPropertiesGroup" Header="{DynamicResource ArcProperties}"
                Visibility="{Binding SupportsArcEditing, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource StartAngle}"/><controls:BufferedNumericTextBox Value="{Binding StartAngle}" />
          <TextBlock Text="{DynamicResource SweepDegrees}"/><controls:BufferedNumericTextBox Value="{Binding SweepDegrees}" />
        </StackPanel>
      </GroupBox>

      <GroupBox x:Name="RectanglePropertiesGroup" Header="{DynamicResource RectangleProperties}"
                Visibility="{Binding SupportsCornerRadius, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource CornerRadius}"/>
          <controls:BufferedNumericTextBox Value="{Binding CornerRadius}" Minimum="0" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="{DynamicResource FontProperties}"
        Visibility="{Binding SupportsFont, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource FontFamily}"/>
          <ComboBox ItemsSource="{Binding FontFamilies}" SelectedItem="{Binding FontFamily}"
                    IsEditable="True" IsTextSearchEnabled="True" AutomationProperties.Name="本机字体" />
          <TextBlock Text="{DynamicResource FontSize}"/><controls:BufferedNumericTextBox Value="{Binding FontSize}" Minimum="0.1" />
          <WrapPanel Margin="0,6,0,0">
            <CheckBox Content="粗体" IsChecked="{Binding FontBold}" Margin="0,0,12,0" />
            <CheckBox Content="斜体" IsChecked="{Binding FontItalic}" />
          </WrapPanel>
          <TextBlock Text="文字颜色与透明度 (#RRGGBB / #AARRGGBB)" Margin="0,6,0,0" />
          <controls:RgbaColorEditor Value="{Binding TextColor}" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="{DynamicResource StrokeProperties}"
        Visibility="{Binding SupportsStroke, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource StrokeWidthMm}" />
          <controls:BufferedNumericTextBox Value="{Binding StrokeWidth}" Minimum="0" />
          <TextBlock Text="边框颜色与透明度 (#RRGGBB / #AARRGGBB)" Margin="0,6,0,0" />
          <controls:RgbaColorEditor Value="{Binding StrokeColor}" />
        </StackPanel>
      </GroupBox>

      <GroupBox Header="{DynamicResource FillProperties}"
                Visibility="{Binding SupportsFill, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,8">
        <StackPanel Margin="8">
          <TextBlock Text="{DynamicResource Fill}" />
          <ComboBox SelectedValue="{Binding FillMode}" SelectedValuePath="Tag">
            <ComboBoxItem Content="{DynamicResource NoFill}" Tag="None" />
            <ComboBoxItem Content="{DynamicResource SolidFill}" Tag="Solid" />
            <ComboBoxItem Content="{DynamicResource HatchFill}" Tag="Hatch" />
          </ComboBox>
          <StackPanel Visibility="{Binding HasSolidFill, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="实色与透明度 (#RRGGBB / #AARRGGBB)" Margin="0,6,0,0" />
            <controls:RgbaColorEditor Value="{Binding SolidFillColor}" />
          </StackPanel>
          <StackPanel Visibility="{Binding HasHatchFill, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Text="{DynamicResource HatchPattern}" Margin="0,6,0,0" />
            <ComboBox ItemsSource="{Binding HatchPatterns}" SelectedItem="{Binding HatchPattern}" />
            <TextBlock Text="底纹前景色与透明度" Margin="0,6,0,0" />
            <controls:RgbaColorEditor Value="{Binding HatchForegroundColor}" />
            <TextBlock Text="底纹背景色与透明度" Margin="0,6,0,0" />
            <controls:RgbaColorEditor Value="{Binding HatchBackgroundColor}" />
          </StackPanel>
        </StackPanel>
      </GroupBox>

      <TextBlock Text="{Binding ValidationSummary}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
