<Window x:Class="Rmpp.Desktop.Views.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="恢复未保存文档" Width="680" Height="420" WindowStartupLocation="CenterOwner"
        KeyboardNavigation.TabNavigation="Cycle">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="丢弃" Click="OnDiscard" Margin="4" KeyboardNavigation.TabIndex="1"/><Button Content="恢复并打开" Click="OnRestore" Margin="4" KeyboardNavigation.TabIndex="2"/>
    </StackPanel>
    <ListBox x:Name="RecoverySessionsList" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession}"
             KeyboardNavigation.TabIndex="0" AutomationProperties.Name="{DynamicResource RecoverySessions}">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding OriginalTemplatePath}"/><TextBlock Text="{Binding UpdatedAt}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}"/>
  </DockPanel>
</Window>
